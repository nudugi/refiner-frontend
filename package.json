  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:content": "node -e \"import('./scripts/lib/content.mjs').then(m=>{m.loadContent();console.log('콘텐츠 OK')}).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "new:exhibition": "node scripts/new.mjs exhibition",
    "new:artist": "node scripts/new.mjs artist",
    "new:work": "node scripts/new.mjs work",
    "new:space": "node scripts/new.mjs space",
